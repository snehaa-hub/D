<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>contact_phone</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(REGEX(  Phone , &quot;\\d{10}&quot;))</errorConditionFormula>
    <errorMessage>📢 Please enter a 10-digit phone number without spaces or dashes.</errorMessage>
</ValidationRule>
