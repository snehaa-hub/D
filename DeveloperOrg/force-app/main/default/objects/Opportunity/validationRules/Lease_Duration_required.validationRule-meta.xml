<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lease_Duration_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Deal_Type__c ,&quot;Lease&quot;),ISBLANK( Lease_Duration__c ) )</errorConditionFormula>
    <errorMessage>Lease Duration required when Deal Type  equal Lease</errorMessage>
</ValidationRule>
