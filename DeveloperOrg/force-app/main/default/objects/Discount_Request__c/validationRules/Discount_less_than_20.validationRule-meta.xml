<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_less_than_20</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Requested_Discount__c   &gt; 20, ISBLANK( Business_Justification__c ))</errorConditionFormula>
    <errorMessage>Discount less than 20  Justification is needed</errorMessage>
</ValidationRule>
