<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pages_Cannot_Be_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK( Pages__c),
 Pages__c &lt;=0)</errorConditionFormula>
    <errorDisplayField>Pages__c</errorDisplayField>
    <errorMessage>Pages_Cannot_Be_Zero</errorMessage>
</ValidationRule>
